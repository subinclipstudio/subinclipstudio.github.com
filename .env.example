# 이 파일을 .env 로 복사한 뒤 필요한 값만 채우세요. 키는 서버에서만 읽고 브라우저로 보내지 않습니다.
# 비워 두면 해당 기능은 화면에 '미연결'로 표시되고, 나머지 기능(영상·자막·음악·게시글)은 그대로 동작합니다.

# [선택·유료] 사진 역할 추정 + 사진 속 문자 후보 추출 (Claude API)
ANTHROPIC_API_KEY=
# VISION_MODEL=claude-opus-5-5

# [선택·유료] NAVER CLOVA Voice 내레이션 (NAVER Cloud Platform)
NCP_CLOVA_CLIENT_ID=
NCP_CLOVA_CLIENT_SECRET=
# CLOVA_TTS_URL=https://naveropenapi.apigw.ntruss.com/tts-premium/v1/tts
# CLOVA_SPEAKER=nara

# [선택] 시스템 FFmpeg / 글꼴 경로를 직접 지정할 때
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FONT_REGULAR=C:\Windows\Fonts\NanumGothic.ttf
# FONT_BOLD=C:\Windows\Fonts\malgunbd.ttf
